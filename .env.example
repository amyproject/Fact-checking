# Open models (DeepSeek, Qwen, Kimi, GLM) and the fine-tune run on Fireworks
FIREWORKS_API_KEY=
# Frontier models (Claude, GPT, Gemini) run through OpenRouter
OPENROUTER_API_KEY=

# Model under test for a single 02_run.py call (a key in models.json); run_all.py sets it per run
MODEL=glm-5.3
# Judge for claim matching, "does this quote back the label?" and the 30 judge rubric checks
JUDGE_MODEL=claude-opus-5.5
# Set after 08_sft_train.py finishes: accounts/<your-account>/models/factcheck-labeler-v1
SFT_MODEL_ID=

# Retrieval: wikipedia (no key) or brave (web search, date-capped to the video date)
RETRIEVER=wikipedia
BRAVE_API_KEY=

# Prices live in models.json (price_in / price_out, $ per 1M tokens); these override them for every model
# PRICE_IN=
# PRICE_OUT=
CONCURRENCY=8
