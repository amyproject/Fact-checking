    "closed_book": {
      "name": "Closed-book",
      "kind": "baseline",
      "desc": "Off-the-shelf model, no tools; may cite URLs from memory (the scorer fetches them)"
    },
    "rag": {
      "name": "A: search + cite",
      "kind": "harness",
      "desc": "2-3 search queries, label from numbered passages, quote the backing sentence"
    },
    "rag_qa": {
      "name": "B: questions + search",
      "kind": "harness",
      "desc": "2-4 verification questions, search each, label"
    },
    "rag_qa_verify": {
      "name": "C: B + quote check",
      "kind": "harness",
      "desc": "B, then a deterministic check that every quote is verbatim in its passage; one repair turn if not"
    },
    "agent": {
      "name": "D: iterative search",
      "kind": "harness",
      "desc": "C, but the model may ask for up to 2 more rounds of searches before it labels"
    },
    "vote": {
      "name": "E: C x5 vote",
      "kind": "harness",
      "desc": "C sampled 5 times at temperature 0.7; majority label, citations from a majority sample"
    }
  },
